---
import PricingAuthCallback from '@/components/pricing-auth-callback.svelte';
import BaseLayout from '@/layouts/base-layout.astro';
import { titleWithBrand } from '@/lib/seo';
---

<BaseLayout
	title={titleWithBrand('Completing sign-in')}
