---
import Footer from '@/components/footer.svelte';
import BuildLogForm from '@/components/build-log-form.svelte';
import GetStarted from '@/components/get-started.svelte';
import SprocketWorkflows from '@/components/sprocket-workflows.astro';
import BaseLayout from '@/layouts/base-layout.astro';
import { CTA_CLICKED_EVENT, EXTERNAL_LINK_CLICKED_EVENT } from '@/lib/analytics/events';
import { fetchLatestSprocketRelease, SPROCKET_GITHUB_URL } from '@/lib/sprocket-releases';
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE, SITE_URL, SPROCKET_DESCRIPTION } from '@/lib/seo';
import {
	marketingButtonPrimaryClass,
	marketingSectionBodyClass,
	marketingTextLinkClass
} from '@/styles/marketing';
import { cn } from '@/utils';

const release = await fetchLatestSprocketRelease();

const capabilities = [
	{
		title: 'Delegate work, follow the progress',
		body: 'Sprocket can split tasks between subagents. Follow their threads in the inbox, send follow-ups, and answer their questions.'
	},
	{
		title: 'Review the results in your project',
		body: 'Inspect code changes, images, technical documents, and rendered previews. Artifacts are shared across threads in the same project.'
	},
	{
		title: 'Choose how you use AI',
		body: 'Choose a model and reasoning effort, connect your ChatGPT subscription, or use your own OpenAI API key.'
	}
] as const;

const steps = [
	{
		title: 'Bring your project',
		body: 'Choose a folder and share the files and requirements that matter.'
	},
	{
		title: 'Guide the work',
		body: 'Answer questions and follow the agent and its subagents as they work.'
	},
	{
		title: 'Check the result',
		body: 'Review outputs and test the changes before putting them to use.'
	}
] as const;

const softwareLd = {
	'@type': 'SoftwareApplication',
	name: 'Sprocket',
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Windows, macOS, Linux',
	url: `${SITE_URL}/sprocket`,
	description: SPROCKET_DESCRIPTION,
	publisher: { '@id': `${SITE_URL}/#organization` }
};
---

<BaseLayout title={DEFAULT_TITLE} description={DEFAULT_DESCRIPTION} jsonLd={softwareLd}>
	<main id="main">
		<section class="atmosphere relative overflow-hidden pt-14" aria-labelledby="home-heading">
			<div class="hero-mesh pointer-events-none absolute inset-0" aria-hidden="true"></div>
			<div
				class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)] lg:gap-14 lg:px-8 lg:py-24"
			>
				<div>
					<p class="font-mono text-xs font-medium tracking-[0.14em] text-accent-strong uppercase">
						AI engineering agent
					</p>
					<h1
						id="home-heading"
						class="mt-4 max-w-2xl font-brand text-4xl leading-[1.08] font-semibold tracking-tight text-foreground sm:text-5xl"
					>
						Build hardware and software <span class="mark-accent inline-block">with Sprocket</span>
					</h1>
					<p class={cn(marketingSectionBodyClass, 'mt-6')}>
						An AI engineering agent that works in your project folder. Research components, develop
						software, create schematics and build documents, and delegate work to subagents.
					</p>
					<p class="mt-4 text-base leading-relaxed text-muted-foreground">
						Follow its progress, review the results, and guide the next step.
					</p>
				</div>
				<div class="flex flex-col gap-5">
					<GetStarted client:idle {release} />
					<a
						href={SPROCKET_GITHUB_URL}
						class={cn(marketingTextLinkClass, 'self-center text-sm')}
						data-ph-capture={EXTERNAL_LINK_CLICKED_EVENT}
						data-ph-destination="github_sprocket"
						data-ph-location="home_hero"
						data-ph-cta="source_available">Source available on GitHub ↗</a
					>
				</div>
			</div>
		</section>

		<section
			id="sprocket"
			class="border-t border-border/50 bg-surface"
			aria-labelledby="sprocket-heading"
			data-ph-section="sprocket"
		>
			<div
				class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-20"
			>
				<div>
					<h2
						id="sprocket-heading"
						class="font-brand text-3xl leading-tight font-semibold tracking-tight sm:text-4xl"
					>
						Work in one project.<br />Stay involved as it grows.
					</h2>
					<ul class="mt-8 divide-y divide-border/60">
						{
							capabilities.map((item) => (
								<li class="py-5 first:pt-0">
									<h3 class="font-brand text-xl font-semibold">{item.title}</h3>
									<p class="mt-2 text-base leading-relaxed text-muted-foreground">{item.body}</p>
								</li>
							))
						}
					</ul>
					<a
						href="/sprocket"
						class={cn(marketingButtonPrimaryClass, 'mt-6')}
						data-ph-capture={CTA_CLICKED_EVENT}
						data-ph-cta="learn_more_sprocket"
						data-ph-location="home_sprocket">Explore Sprocket →</a
					>
				</div>
				<div class="self-start rounded-2xl border border-border/70 bg-background p-6 sm:p-8">
					<p class="font-mono text-xs font-medium tracking-[0.14em] text-accent-strong uppercase">
						How you work
					</p>
					<ol class="mt-6 space-y-8">
						{
							steps.map((step, index) => (
								<li class="flex gap-4">
									<span
										class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-soft font-mono text-sm text-foreground"
										aria-hidden="true"
									>
										0{index + 1}
									</span>
									<div>
										<h3 class="font-brand text-xl font-semibold">{step.title}</h3>
										<p class="mt-2 text-base leading-relaxed text-muted-foreground">{step.body}</p>
									</div>
								</li>
							))
						}
					</ol>
					<p
						class="mt-8 border-t border-border/70 pt-5 text-sm leading-relaxed text-muted-foreground"
					>
						Use the desktop app, work in your browser, or run a task from your terminal.
					</p>
				</div>
			</div>
		</section>

		<section
			id="platform"
			class="border-t border-border/50 bg-background"
			aria-labelledby="workflows-heading"
			data-ph-section="platform"
		>
			<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
				<p class="font-mono text-xs font-medium tracking-[0.14em] text-accent-strong uppercase">
					Example tasks
				</p>
				<h2
					id="workflows-heading"
					class="mt-4 font-brand text-3xl leading-tight font-semibold tracking-tight sm:text-4xl"
				>
					What will you work on next?
				</h2>
				<p class={cn(marketingSectionBodyClass, 'mt-4 mb-8')}>
					Start with an existing codebase, a new device, or a system that needs both.
				</p>
				<SprocketWorkflows />
				<a
					href="/sprocket#examples"
					class={cn(marketingTextLinkClass, 'mt-8 inline-flex')}
					data-ph-capture={CTA_CLICKED_EVENT}
					data-ph-cta="explore_example_tasks"
					data-ph-location="home_platform">See prompts to try →</a
				>
			</div>
		</section>

		<section
			id="vario"
			class="border-t border-border/50 bg-surface"
			aria-labelledby="vario-heading"
			data-ph-section="vario"
		>
			<div
				class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8"
			>
				<div>
					<h2 class="font-brand text-2xl font-semibold">Why we're building Spikonado</h2>
					<p class="mt-4 text-base leading-relaxed text-muted-foreground">
						Our goal is to give more people the tools to invent apps, robots, devices, and the
						systems that connect them. Sprocket is available now. Vario is what we're building next.
					</p>
				</div>
				<div>
					<p class="font-mono text-xs font-medium tracking-[0.14em] text-accent-strong uppercase">
						Coming soon
					</p>
					<h2 id="vario-heading" class="mt-3 font-brand text-3xl font-semibold">Vario</h2>
					<p class="mt-3 text-base leading-relaxed text-muted-foreground">
						Modular robotics hardware.
					</p>
					<a
						href="/#build-log"
						class={cn(marketingTextLinkClass, 'mt-5 inline-flex')}
						data-ph-capture={CTA_CLICKED_EVENT}
						data-ph-cta="vario_get_notified"
						data-ph-location="home_vario">Get notified when Vario ships →</a
					>
				</div>
			</div>
		</section>

		<section
			id="build-log"
			class="border-t border-border/50 bg-background"
			aria-labelledby="build-log-heading"
			data-ph-section="build_log"
		>
			<div
				class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8"
			>
				<div>
					<h2
						id="build-log-heading"
						class="font-brand text-3xl font-semibold tracking-tight sm:text-4xl"
					>
						Follow what we're building
					</h2>
					<p class={cn(marketingSectionBodyClass, 'mt-4')}>
						Sprocket releases, engineering notes, and updates on Vario.
					</p>
				</div>
				<div>
					<BuildLogForm client:visible />
				</div>
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>
