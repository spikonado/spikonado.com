---
import Footer from '@/components/footer.svelte';
import PricingPlans from '@/components/pricing-plans';
import BaseLayout from '@/layouts/base-layout.astro';
import type { PublicPricingCatalog } from '@/lib/convex/api';
import { fetchPublicPricingCatalog } from '@/lib/pricing/billing-client';
import { priceLabel, pricesForPlan, pricingFaqs } from '@/lib/pricing/catalog';
import { fetchPricingModelCatalog, type PricingModelCatalog } from '@/lib/pricing/model-catalog';
import { SITE_URL, titleWithBrand } from '@/lib/seo';

const title = titleWithBrand('Pricing');
const description =
	'Compare Sprocket plans and choose the AI usage limits that fit your engineering work.';

const convexUrl = import.meta.env.PUBLIC_CONVEX_URL?.trim();
let initialCatalog: PublicPricingCatalog | null = null;
if (convexUrl) {
	try {
		initialCatalog = await fetchPublicPricingCatalog(convexUrl);
	} catch {
		initialCatalog = null;
	}
}

async function loadModelCatalog(): Promise<PricingModelCatalog | null> {
	try {
		return await fetchPricingModelCatalog();
	} catch {
		return null;
	}
}
const initialModelCatalog = await loadModelCatalog();

const offers = initialCatalog
	? initialCatalog.plans.flatMap((plan) => {
			if (plan.id === 'free') {
				return [
					{
						'@type': 'Offer',
						name: `Sprocket ${plan.label}`,
						price: '0',
						priceCurrency: 'USD',
						description: plan.description ?? 'Start building with Sprocket at no cost.'
					}
				];
			}
			const prices = pricesForPlan(plan);
			return (['monthly', 'annual'] as const).flatMap((interval) => {
				const price = priceLabel(interval, prices);
				if (!price) return [];
				return [
					{
						'@type': 'Offer',
						name: `Sprocket ${plan.label} ${interval === 'annual' ? 'Annual' : 'Monthly'}`,
						price: String(price.periodMajor),
						priceCurrency: price.currency,
						billingDuration: interval === 'annual' ? 'P1Y' : 'P1M',
						description: plan.description ?? `${plan.label} Sprocket subscription.`
					}
				];
			});
		})
	: [
			{
				'@type': 'Offer',
				name: 'Sprocket Free',
				price: '0',
				priceCurrency: 'USD',
				description: 'Start building with Sprocket at no cost.'
			}
		];

const productLd = {
	'@type': 'Product',
	name: 'Sprocket',
	description,
	brand: { '@type': 'Brand', name: 'Spikonado' },
	url: `${SITE_URL}/pricing`,
	offers
};

const faqLd = {
	'@type': 'FAQPage',
	mainEntity: pricingFaqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.answer
		}
	}))
};
---

<BaseLayout title={title} description={description} jsonLd={[productLd, faqLd]}>
	<main id="main" class="atmosphere min-h-svh px-4 pt-28 pb-16 sm:px-6 sm:pt-32 lg:px-8">
		<article class="mx-auto max-w-6xl">
			<PricingPlans
				client:load
				initialCatalog={initialCatalog}
				initialModelCatalog={initialModelCatalog}
			/>
		</article>
	</main>
	<Footer />
</BaseLayout>
