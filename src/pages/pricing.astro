---
import Footer from '@/components/footer.svelte';
import PricingPlans from '@/components/pricing-plans';
import BaseLayout from '@/layouts/base-layout.astro';
import type { PublicPricingCatalog } from '@/lib/convex/api';
import { fetchPublicPricingCatalog } from '@/lib/pricing/billing-client';
import { pricingFaqs, proPriceLabel } from '@/lib/pricing/catalog';
import { SITE_URL, titleWithBrand } from '@/lib/seo';

const title = titleWithBrand('Pricing');
const description =
	'Sprocket pricing for Free, Pro, and Enterprise. Start free, upgrade to Pro for higher limits and full model access, or contact sales for Enterprise.';

const convexUrl = import.meta.env.PUBLIC_CONVEX_URL?.trim();
let initialCatalog: PublicPricingCatalog | null = null;
if (convexUrl) {
	try {
		initialCatalog = await fetchPublicPricingCatalog(convexUrl);
	} catch {
		initialCatalog = null;
	}
}

const monthlyPrice = proPriceLabel('monthly', initialCatalog?.proPrices ?? null);
const annualPrice = proPriceLabel('annual', initialCatalog?.proPrices ?? null);

const offers = [
	{
		'@type': 'Offer',
		name: 'Sprocket Free',
		price: '0',
		priceCurrency: 'USD',
		description: 'Start building with Sprocket at no cost.'
	},
	...(monthlyPrice
		? [
				{
					'@type': 'Offer',
					name: 'Sprocket Pro Monthly',
					price: String(monthlyPrice.periodMajor),
					priceCurrency: monthlyPrice.currency,
					billingDuration: 'P1M',
					description: 'Higher limits and full model access for serious engineering work.'
				}
			]
		: []),
	...(annualPrice
		? [
				{
					'@type': 'Offer',
					name: 'Sprocket Pro Annual',
					price: String(annualPrice.periodMajor),
					priceCurrency: annualPrice.currency,
					billingDuration: 'P1Y',
					description: `Annual Pro billed at ${annualPrice.periodLabel}/year.`
				}
			]
		: [])
];

const productLd = {
	'@type': 'Product',
	name: 'Sprocket',
	description,
	brand: { '@type': 'Brand', name: 'Spikonado' },
	url: `${SITE_URL}/pricing`,
	offers
};

const faqLd = {
	'@type': 'FAQPage',
	mainEntity: pricingFaqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.answer
		}
	}))
};
---

<BaseLayout title={title} description={description} jsonLd={[productLd, faqLd]}>
	<main id="main" class="atmosphere min-h-svh px-4 pt-28 pb-16 sm:px-6 sm:pt-32 lg:px-8">
		<article class="mx-auto max-w-6xl">
			<PricingPlans client:load initialCatalog={initialCatalog} />
		</article>
	</main>
	<Footer />
</BaseLayout>
