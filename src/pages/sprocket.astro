---
import CopyCommand from '@/components/copy-command.svelte';
import ProductImagePlaceholder from '@/components/product-image-placeholder.astro';
import SprocketCapabilities from '@/components/sprocket-capabilities.astro';
import SprocketDownload from '@/components/sprocket-download.svelte';
import BaseLayout from '@/layouts/base-layout.astro';
import { CTA_CLICKED_EVENT, EXTERNAL_LINK_CLICKED_EVENT } from '@/lib/analytics/events';
import {
	fetchLatestSprocketRelease,
	SPROCKET_GITHUB_URL,
	SPROCKET_NPM_COMMAND,
	SPROCKET_NPM_URL,
	SPROCKET_RELEASES_LATEST_URL
} from '@/lib/sprocket-releases';
import { SITE_URL, SPROCKET_DESCRIPTION, titleWithBrand } from '@/lib/seo';
import {
	marketingButtonPrimaryClass,
	marketingCopyCommandSurfaceClass,
	marketingProductHeadingClass,
	marketingSectionBodyClass,
	marketingTextLinkClass
} from '@/styles/marketing';
import { cn } from '@/utils';

const release = await fetchLatestSprocketRelease();

const title = titleWithBrand('Sprocket - The Engineering Agent');
const description = SPROCKET_DESCRIPTION;

const softwareLd = {
	'@type': 'SoftwareApplication',
	name: 'Sprocket',
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Windows, macOS, Linux',
	url: `${SITE_URL}/sprocket`,
	description,
	downloadUrl: release?.htmlUrl ?? SPROCKET_RELEASES_LATEST_URL,
	installUrl: SPROCKET_NPM_URL,
	publisher: { '@id': `${SITE_URL}/#organization` }
};

const featureIconClass =
	'mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-accent-soft text-accent-strong';
const featureTextClass = 'text-base leading-relaxed text-muted-foreground md:text-lg';
---

<BaseLayout title={title} description={description} jsonLd={softwareLd}>
	<main id="main" class="atmosphere min-h-svh px-4 pt-28 pb-20 sm:px-6 sm:pt-32 lg:px-8">
		<article class="mx-auto max-w-3xl">
			<p class="font-mono text-xs font-medium tracking-[0.14em] text-accent-strong uppercase">
				Product
			</p>
			<h1 class={cn(marketingProductHeadingClass, 'mt-3')}>Sprocket</h1>
			<p class={cn(marketingSectionBodyClass, 'mt-6')}>
				An AI engineering agent for{' '}
				<span class="mark-verb">hardware</span> and{' '}
				<span class="mark-verb">software</span>.
			</p>
			<figure
				class="mt-8 overflow-hidden rounded-2xl border border-border/70 bg-ink shadow-[0_30px_80px_-40px_oklch(0.2_0.02_260/0.7)]"
			>
				<ProductImagePlaceholder />
			</figure>
			<ul class="mt-6 divide-y divide-border/60 border-y border-border/60">
				<li class="flex gap-4 py-5">
					<span class={featureIconClass} aria-hidden="true">
						<svg viewBox="0 0 16 16" class="h-4 w-4" fill="none">
							<path
								d="M3.5 8.5 6.5 11.5 12.5 4.5"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</span>
					<p class={featureTextClass}>
						<span class="mark-verb">Design the electronics and the software</span>. Schematics,
						BOMs, assembly guides, firmware, and apps in one project.
					</p>
				</li>
				<li class="flex gap-4 py-5">
					<span class={featureIconClass} aria-hidden="true">
						<svg viewBox="0 0 16 16" class="h-4 w-4" fill="none">
							<path
								d="M3.5 8.5 6.5 11.5 12.5 4.5"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</span>
					<p class={featureTextClass}>
						<span class="mark-verb">Research real components</span> using datasheets, current docs, and
						supplier websites. Watch browser work live and take over when needed.
					</p>
				</li>
				<li class="flex gap-4 py-5">
					<span class={featureIconClass} aria-hidden="true">
						<svg viewBox="0 0 16 16" class="h-4 w-4" fill="none">
							<path
								d="M3.5 8.5 6.5 11.5 12.5 4.5"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</span>
					<p class={featureTextClass}>
						<span class="mark-verb">Purchase parts and services</span> with spending limits you approve.
						Go from a parts list to sourcing what your build needs.
					</p>
				</li>
			</ul>

			<section
				class="mt-10"
				aria-labelledby="sprocket-install-heading"
				data-ph-section="sprocket_install"
			>
				<h2 id="sprocket-install-heading" class="font-brand text-xl font-semibold text-foreground">
					Install
				</h2>

				<div class="mt-6 max-w-md space-y-5">
					<SprocketDownload client:idle release={release} location="sprocket_page" />

					<div class="relative flex items-center gap-3" aria-hidden="true">
						<div class="h-px flex-1 bg-border/80"></div>
						<span class="font-sans text-xs tracking-wide text-muted-foreground uppercase">or</span>
						<div class="h-px flex-1 bg-border/80"></div>
					</div>

					<CopyCommand
						client:idle
						command={SPROCKET_NPM_COMMAND}
						location="sprocket_page"
						class={cn('w-full', marketingCopyCommandSurfaceClass)}
					/>
				</div>
			</section>

			<div class="mt-10 flex flex-wrap items-center gap-4">
				<a
					href={SPROCKET_GITHUB_URL}
					class={marketingButtonPrimaryClass}
					target="_blank"
					rel="noopener noreferrer"
					data-ph-capture={EXTERNAL_LINK_CLICKED_EVENT}
					data-ph-destination="github_sprocket"
					data-ph-location="sprocket_page"
					data-ph-cta="view_on_github"
				>
					View on GitHub →
				</a>
				<a
					href="/"
					class={marketingTextLinkClass}
					data-ph-capture={CTA_CLICKED_EVENT}
					data-ph-cta="back_home"
					data-ph-location="sprocket_page"
				>
					Back home
				</a>
			</div>
		</article>
		<div class="-mx-4 mt-20 sm:-mx-6 lg:-mx-8">
			<SprocketCapabilities />
		</div>
	</main>
</BaseLayout>
