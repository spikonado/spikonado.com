---
import CopyCommand from '@/components/copy-command.svelte';
import BaseLayout from '@/layouts/base-layout.astro';
import { SITE_URL, titleWithBrand } from '@/lib/seo';
import {
	marketingButtonPrimaryClass,
	marketingCopyCommandSurfaceClass,
	marketingProductHeadingClass,
	marketingSectionBodyClass,
	marketingTextLinkClass
} from '@/styles/marketing';
import { cn } from '@/utils';

const title = titleWithBrand('Sprocket engineering agent');
const description =
	"Sprocket is Spikonado's engineering agent for hardware and software. It writes high-quality code and retrieves best-in-class context from the web and open-source projects. Start with npx @spikonado/sprocket --web.";

const softwareLd = {
	'@type': 'SoftwareApplication',
	name: 'Sprocket',
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Windows, macOS, Linux',
	url: `${SITE_URL}/sprocket`,
	description,
	downloadUrl: 'https://www.npmjs.com/package/@spikonado/sprocket',
	installUrl: 'https://www.npmjs.com/package/@spikonado/sprocket',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD'
	},
	publisher: { '@id': `${SITE_URL}/#organization` }
};
---

<BaseLayout title={title} description={description} jsonLd={softwareLd}>
	<main id="main" class="atmosphere min-h-svh px-4 pt-28 pb-20 sm:px-6 sm:pt-32 lg:px-8">
		<article class="mx-auto max-w-3xl">
			<p class="font-mono text-xs font-medium tracking-[0.14em] text-accent-strong uppercase">
				Product
			</p>
			<h1 class={cn(marketingProductHeadingClass, 'mt-3')}>Sprocket</h1>
			<p class={cn(marketingSectionBodyClass, 'mt-6')}>
				Sprocket writes <span class="mark-verb">high-quality code</span>, and retrieves{' '}
				<span class="mark-verb">best-in-class context</span> from the{' '}
				<span class="mark-verb">web and open-source projects</span>.
			</p>
			<p class={cn(marketingSectionBodyClass, 'mt-4')}>
				More of this page is coming soon. In the meantime, launch Sprocket in your browser:
			</p>

			<CopyCommand
				client:idle
				class={cn('mt-8 w-full max-w-md', marketingCopyCommandSurfaceClass)}
			/>

			<div class="mt-8 flex flex-wrap items-center gap-4">
				<a
					href="https://github.com/spikonado/sprocket"
					class={marketingButtonPrimaryClass}
					target="_blank"
					rel="noopener noreferrer"
				>
					View on GitHub →
				</a>
				<a href="/" class={marketingTextLinkClass}> Back home </a>
			</div>
		</article>
	</main>
</BaseLayout>
