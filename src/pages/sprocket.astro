---
import CopyCommand from '@/components/copy-command.svelte';
import SprocketDownload from '@/components/sprocket-download.svelte';
import BaseLayout from '@/layouts/base-layout.astro';
import {
	fetchLatestSprocketRelease,
	SPROCKET_GITHUB_URL,
	SPROCKET_NPM_COMMAND,
	SPROCKET_NPM_URL,
	SPROCKET_RELEASES_LATEST_URL
} from '@/lib/sprocket-releases';
import { SITE_URL, titleWithBrand } from '@/lib/seo';
import {
	marketingButtonPrimaryClass,
	marketingCopyCommandSurfaceClass,
	marketingProductHeadingClass,
	marketingSectionBodyClass,
	marketingTextLinkClass
} from '@/styles/marketing';
import { cn } from '@/utils';

const release = await fetchLatestSprocketRelease();

const title = titleWithBrand('Sprocket - The Engineering Agent');
const description =
	"Sprocket is Spikonado's engineering agent for hardware and software. It writes high-quality code and retrieves best-in-class context from the web and open-source projects. Start with npx @spikonado/sprocket, or download the desktop app.";

const softwareLd = {
	'@type': 'SoftwareApplication',
	name: 'Sprocket',
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Windows, macOS, Linux',
	url: `${SITE_URL}/sprocket`,
	description,
	downloadUrl: release?.htmlUrl ?? SPROCKET_RELEASES_LATEST_URL,
	installUrl: SPROCKET_NPM_URL,
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD'
	},
	publisher: { '@id': `${SITE_URL}/#organization` }
};
---

<BaseLayout title={title} description={description} jsonLd={softwareLd}>
	<main id="main" class="atmosphere min-h-svh px-4 pt-28 pb-20 sm:px-6 sm:pt-32 lg:px-8">
		<article class="mx-auto max-w-3xl">
			<p class="font-mono text-xs font-medium tracking-[0.14em] text-accent-strong uppercase">
				Product
			</p>
			<h1 class={cn(marketingProductHeadingClass, 'mt-3')}>Sprocket</h1>
			<p class={cn(marketingSectionBodyClass, 'mt-6')}>
				Sprocket writes <span class="mark-verb">high-quality code</span>, and retrieves{' '}
				<span class="mark-verb">best-in-class context</span> from the{' '}
				<span class="mark-verb">web and open-source projects</span>.
			</p>
			<p class={cn(marketingSectionBodyClass, 'mt-4')}>More of this page is coming soon.</p>

			<section class="mt-10" aria-labelledby="sprocket-install-heading">
				<h2 id="sprocket-install-heading" class="font-brand text-xl font-semibold text-foreground">
					Install
				</h2>

				<div class="mt-6 max-w-md space-y-5">
					<SprocketDownload client:idle release={release} />

					<div class="relative flex items-center gap-3" aria-hidden="true">
						<div class="h-px flex-1 bg-border/80"></div>
						<span class="font-sans text-xs tracking-wide text-muted-foreground uppercase">or</span>
						<div class="h-px flex-1 bg-border/80"></div>
					</div>

					<CopyCommand
						client:idle
						command={SPROCKET_NPM_COMMAND}
						class={cn('w-full', marketingCopyCommandSurfaceClass)}
					/>
				</div>
			</section>

			<div class="mt-10 flex flex-wrap items-center gap-4">
				<a
					href={SPROCKET_GITHUB_URL}
					class={marketingButtonPrimaryClass}
					target="_blank"
					rel="noopener noreferrer"
				>
					View on GitHub →
				</a>
				<a href="/" class={marketingTextLinkClass}> Back home </a>
			</div>
		</article>
	</main>
</BaseLayout>
