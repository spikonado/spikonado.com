---
import CopyCommand from '@/components/copy-command.svelte';
import Footer from '@/components/footer.svelte';
import SprocketDownload from '@/components/sprocket-download.svelte';
import SprocketScreenshot from '@/components/sprocket-screenshot.svelte';
import ContextMock from '@/components/sprocket/mocks/context-mock.astro';
import HardwareMock from '@/components/sprocket/mocks/hardware-mock.astro';
import PurchaseMock from '@/components/sprocket/mocks/purchase-mock.astro';
import QuestionsMock from '@/components/sprocket/mocks/questions-mock.astro';
import SubagentsMock from '@/components/sprocket/mocks/subagents-mock.astro';
import BaseLayout from '@/layouts/base-layout.astro';
import { CTA_CLICKED_EVENT, EXTERNAL_LINK_CLICKED_EVENT } from '@/lib/analytics/events';
import {
	fetchLatestSprocketRelease,
	SPROCKET_GITHUB_URL,
	SPROCKET_NPM_COMMAND,
	SPROCKET_NPM_URL,
	SPROCKET_RELEASES_LATEST_URL
} from '@/lib/sprocket-releases';
import { SITE_URL, SPROCKET_DESCRIPTION, titleWithBrand } from '@/lib/seo';
import {
	marketingButtonPrimaryClass,
	marketingCopyCommandSurfaceClass,
	marketingSectionBodyClass,
	marketingSectionHeadingClass
} from '@/styles/marketing';
import { cn } from '@/utils';

const release = await fetchLatestSprocketRelease();

const title = titleWithBrand('Sprocket - The best AI agent for hardware and software');
const description = SPROCKET_DESCRIPTION;

const showcases = [
	{
		id: 'electronics',
		heading: 'Design electronics',
		body: 'Describe a device, and Sprocket designs the board around real parts.',
		points: [
			'Draws KiCad schematics from the datasheets of the parts it picks',
			'Writes the BOM, pin maps, and step-by-step assembly guides',
			'Writes and tests the firmware that runs on the board'
		],
		mock: HardwareMock
	},
	{
		id: 'context',
		heading: 'Work from real docs',
		body: 'Sprocket checks current sources before it acts, so its answers hold up on real hardware.',
		points: [
			'Searches the web and reads full pages, not just snippets',
			'Reads PDFs, spreadsheets, and images you share',
			'Runs commands to confirm the fix works'
		],
		mock: ContextMock
	},
	{
		id: 'purchasing',
		heading: 'Buy what the project needs',
		body: 'Sprocket orders parts and subscriptions for you, within limits you set.',
		points: [
			'You approve each spending limit once with a passkey',
			'Limits are locked to a merchant and an amount',
			'Unused money goes back as soon as the order completes'
		],
		mock: PurchaseMock
	},
	{
		id: 'questions',
		heading: 'Ask before guessing',
		body: 'When a request is ambiguous, Sprocket asks a quick question instead of assuming.',
		points: [
			'Multiple-choice answers for design choices, frameworks, and parts',
			"An option to let Sprocket decide when you don't mind",
			'Your answer goes straight into the work'
		],
		mock: QuestionsMock
	},
	{
		id: 'subagents',
		heading: 'Split big tasks',
		body: 'Sprocket hands parts of a large task to subagents that work in parallel.',
		points: [
			'Each subagent has its own context, so the main thread stays focused',
			'Research, building, and review happen at the same time',
			'Subagents can work in their own git worktrees'
		],
		mock: SubagentsMock
	}
] as const;

const capabilities = [
	{ name: 'Schematics', body: 'KiCad schematics you can open, edit, and route' },
	{ name: 'BOMs and pin maps', body: 'Parts lists and wiring tables for every board' },
	{ name: 'Assembly guides', body: 'Step-by-step instructions for building the device' },
	{ name: 'Firmware and apps', body: 'Writes and tests code across your whole system' },
	{ name: 'Web context', body: 'Searches the web and reads full pages and docs' },
	{ name: 'Files', body: 'Reads PDFs, spreadsheets, images, and more' },
	{ name: 'Purchasing', body: 'Buys parts and subscriptions within approved limits' },
	{ name: 'Questions', body: 'Asks multiple-choice questions when a task is unclear' },
	{ name: 'Subagents', body: 'Runs parallel agents for research, building, and review' },
	{ name: 'Skills', body: 'Reusable instructions for your workflows, called with $' },
	{ name: 'AGENTS.md', body: 'Project rules that apply per directory' },
	{ name: 'Artifacts', body: 'Docs, schematics, and previews in a side panel' },
	{ name: 'Git', body: 'Branches, worktrees, commits, and pull requests' },
	{ name: 'Terminal', body: 'Runs builds, tests, and flashing tools for you' },
	{ name: 'CLI', body: 'Run tasks from your terminal with sprocket run' },
	{ name: 'Desktop or browser', body: 'Use the desktop app, or open Sprocket in a browser' },
	{ name: 'Your own keys', body: 'Bring API keys and subscriptions from AI providers' },
	{ name: 'Fair source', body: 'Read the code, and self-host anytime' }
] as const;

const softwareLd = {
	'@type': 'SoftwareApplication',
	name: 'Sprocket',
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Windows, macOS, Linux',
	url: `${SITE_URL}/sprocket`,
	description,
	downloadUrl: release?.htmlUrl ?? SPROCKET_RELEASES_LATEST_URL,
	installUrl: SPROCKET_NPM_URL,
	featureList: capabilities.map(({ name, body }) => `${name}: ${body}`),
	...(release ? { softwareVersion: release.version } : {}),
	publisher: { '@id': `${SITE_URL}/#organization` }
};

const chipClass =
	'inline-flex items-center gap-1 rounded-full bg-foreground/6 px-3.5 py-1.5 font-sans text-sm font-medium text-muted-foreground transition-colors hover:bg-foreground/10 hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring/50 focus-visible:outline-none';
const chips = [
	{
		label: 'GitHub',
		href: SPROCKET_GITHUB_URL,
		cta: 'view_on_github',
		destination: 'github_sprocket'
	},
	{
		label: 'Releases',
		href: SPROCKET_RELEASES_LATEST_URL,
		cta: 'releases',
		destination: 'github_sprocket_releases'
	},
	{ label: 'Pricing', href: '/pricing', cta: 'see_pricing', destination: null }
] as const;

const subheadingClass =
	'font-brand text-3xl font-semibold tracking-tight text-foreground sm:text-4xl';
const installControlClass = 'h-12 w-full rounded-xl text-left sm:w-auto';
---

<BaseLayout title={title} description={description} jsonLd={softwareLd}>
	<main id="main" class="atmosphere">
		<section
			class="relative overflow-hidden px-4 pt-32 pb-16 text-center sm:px-6 sm:pt-40 lg:px-8"
			data-ph-section="sprocket_hero"
		>
			<div class="hero-mesh pointer-events-none absolute inset-0" aria-hidden="true"></div>
			<div class="relative mx-auto max-w-3xl">
				{
					release && (
						<a
							href={release.htmlUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/80 py-1 pr-3 pl-1 font-sans text-sm text-foreground transition-colors hover:bg-surface"
							data-ph-capture={EXTERNAL_LINK_CLICKED_EVENT}
							data-ph-destination="github_sprocket_release"
							data-ph-location="sprocket_page"
							data-ph-cta="release_badge"
						>
							<span class="rounded-full bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent-strong">
								New
							</span>
							Sprocket {release.version} is out
							<span aria-hidden="true">↗</span>
						</a>
					)
				}
				<h1 class={cn(marketingSectionHeadingClass, 'mt-6')}>
					The best AI agent for hardware and software.
				</h1>
				<p class={cn(marketingSectionBodyClass, 'mx-auto mt-6')}>
					Sprocket designs electronics, writes and tests code, and buys the parts your project
					needs.
				</p>

				<!-- `contents` puts the download button and its platform links in this row's flex flow. -->
				<div class="mx-auto mt-10 flex max-w-xl flex-wrap justify-center gap-3">
					<SprocketDownload
						client:idle
						release={release}
						location="sprocket_page"
						class="contents"
						buttonClass={installControlClass}
						alternatesClass="order-last mt-1 basis-full"
					/>
					<CopyCommand
						client:idle
						command={SPROCKET_NPM_COMMAND}
						location="sprocket_page"
						class={cn(installControlClass, 'py-0 pr-1.5', marketingCopyCommandSurfaceClass)}
					/>
				</div>

				<ul class="mt-6 flex flex-wrap justify-center gap-2">
					{
						chips.map((chip) => (
							<li>
								<a
									href={chip.href}
									class={chipClass}
									{...(chip.destination
										? {
												target: '_blank',
												rel: 'noopener noreferrer',
												'data-ph-capture': EXTERNAL_LINK_CLICKED_EVENT,
												'data-ph-destination': chip.destination
											}
										: { 'data-ph-capture': CTA_CLICKED_EVENT })}
									data-ph-cta={chip.cta}
									data-ph-location="sprocket_page"
								>
									{chip.label}
									<span aria-hidden="true">›</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<figure
				class="relative mx-auto mt-16 max-w-5xl overflow-hidden rounded-2xl border border-border/70 bg-ink shadow-[0_30px_80px_-40px_oklch(0.2_0.02_260/0.7)]"
			>
				<SprocketScreenshot client:visible location="sprocket_page" />
			</figure>
		</section>

		<div class="mx-auto max-w-6xl border-t border-border/70 px-4 sm:px-6 lg:px-8">
			{
				showcases.map(({ id, heading, body, points, mock: Mock }, index) => (
					<section
						id={id}
						aria-labelledby={`${id}-heading`}
						data-ph-section={`sprocket_${id}`}
						class="grid scroll-mt-24 items-center gap-10 py-16 lg:grid-cols-2 lg:gap-16 lg:py-24"
					>
						<div class={cn(index % 2 === 1 && 'lg:order-2')}>
							<h2 id={`${id}-heading`} class={subheadingClass}>
								{heading}
							</h2>
							<p class={cn(marketingSectionBodyClass, 'mt-4')}>{body}</p>
							<ul class="mt-6 space-y-3">
								{points.map((point) => (
									<li class="flex gap-3 text-base leading-relaxed text-muted-foreground">
										<svg
											viewBox="0 0 16 16"
											class="mt-1 h-4 w-4 shrink-0 text-accent-strong"
											fill="none"
											aria-hidden="true"
										>
											<path
												d="M3.5 8.5 6.5 11.5 12.5 4.5"
												stroke="currentColor"
												stroke-width="1.8"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
										{point}
									</li>
								))}
							</ul>
						</div>
						<Mock />
					</section>
				))
			}
		</div>

		<section
			class="border-t border-border/70 px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
			aria-labelledby="capabilities-heading"
			data-ph-section="sprocket_capabilities"
		>
			<div class="mx-auto max-w-6xl">
				<h2 id="capabilities-heading" class={cn(subheadingClass, 'text-center')}>
					Everything you need to invent
				</h2>
				<p class={cn(marketingSectionBodyClass, 'mx-auto mt-4 text-center')}>
					One agent for the whole build, from the first idea to a working device.
				</p>
				<dl
					class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-border/70 bg-border/70 sm:grid-cols-2 lg:grid-cols-3"
				>
					{
						capabilities.map(({ name, body }) => (
							<div class="bg-surface/90 p-5">
								<dt class="font-brand font-semibold text-foreground">{name}</dt>
								<dd class="mt-1 text-sm leading-relaxed text-muted-foreground">{body}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</section>

		<section
			class="border-t border-border/70 px-4 py-20 text-center sm:px-6 lg:px-8 lg:py-28"
			aria-labelledby="sprocket-install-heading"
			data-ph-section="sprocket_install"
		>
			<h2 id="sprocket-install-heading" class={subheadingClass}>Start building with Sprocket</h2>
			<p class={cn(marketingSectionBodyClass, 'mx-auto mt-4')}>
				Download the app, or run it with one command.
			</p>
			<div class="mx-auto mt-8 flex max-w-xl flex-wrap justify-center gap-3">
				<SprocketDownload
					client:visible
					release={release}
					showAlternates={false}
					location="sprocket_page_cta"
					class="contents"
					buttonClass={installControlClass}
				/>
				<CopyCommand
					client:visible
					command={SPROCKET_NPM_COMMAND}
					location="sprocket_page_cta"
					class={cn(installControlClass, 'py-0 pr-1.5', marketingCopyCommandSurfaceClass)}
				/>
			</div>
			<a
				href="/pricing"
				class={cn(marketingButtonPrimaryClass, 'mt-8')}
				data-ph-capture={CTA_CLICKED_EVENT}
				data-ph-cta="see_pricing"
				data-ph-location="sprocket_page_cta"
			>
				See pricing →
			</a>
		</section>
	</main>
	<Footer />
</BaseLayout>
