---
import facebookLogo from '@/assets/facebook_logo.svg';
import githubLogo from '@/assets/github_logo.svg';
import instagramLogo from '@/assets/instagram_logo.svg';
import SpikonadoLockup from '@/assets/spikonado-lockup.svg';
import xLogo from '@/assets/x_logo.svg';
import youtubeLogo from '@/assets/youtube_logo.svg';
import { ORGANIZATION_SOCIALS, SPROCKET_SITE_URL } from '@/lib/seo';
import { marketingSectionBodyClass, marketingSectionShellClass } from '@/styles/marketing';
import { cn } from '@/utils';

const linkColumns = [
	{
		heading: 'Products',
		links: [
			{ label: 'Sprocket', href: SPROCKET_SITE_URL },
			{ label: 'Vario', href: '/#vario' }
		]
	},
	{
		heading: 'Company',
		links: [
			{ label: 'Pricing', href: `${SPROCKET_SITE_URL}/pricing` },
			{ label: 'Build log', href: '/#build-log' },
			{ label: 'Privacy Policy', href: '/privacy' }
		]
	}
];

const socialIcons = {
	GitHub: githubLogo,
	X: xLogo,
	YouTube: youtubeLogo,
	Instagram: instagramLogo,
	Facebook: facebookLogo
} satisfies Record<(typeof ORGANIZATION_SOCIALS)[number]['label'], ImageMetadata>;
---

<footer
	class={cn(
		marketingSectionShellClass,
		'border-t border-border/60 px-4 pt-20 pb-10 sm:px-6 sm:pt-24 lg:px-8'
	)}
	data-ph-capture-attribute-section="footer"
>
	<div
		class="relative mx-auto grid w-full max-w-6xl grid-cols-1 gap-12 text-center md:grid-cols-[minmax(0,2fr)_minmax(10rem,1fr)_minmax(10rem,1fr)] md:gap-16 md:text-left"
	>
		<div class="flex flex-col items-center gap-5 md:items-start">
			<a
				href="/"
				aria-label="Spikonado"
				class="text-foreground transition-transform duration-150 hover:scale-105"
			>
				<SpikonadoLockup class="h-9 w-auto sm:h-10" aria-hidden="true" />
			</a>
			<p class={cn(marketingSectionBodyClass, 'text-base md:text-lg')}>Build more tech, faster.</p>
		</div>

		{
			linkColumns.map(({ heading, links }) => (
				<div class="flex flex-col items-center gap-4 md:items-start">
					<h3 class="font-sans text-xs font-medium tracking-wide text-muted-foreground uppercase">
						{heading}
					</h3>
					<ul class="space-y-3">
						{links.map((link) => (
							<li>
								<a
									href={link.href}
									class="font-sans text-base text-foreground transition-colors hover:text-muted-foreground md:text-lg"
								>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>

	<div
		class="relative mx-auto mt-16 flex w-full max-w-6xl flex-col items-center justify-between gap-6 border-t border-border/50 pt-8 text-sm text-muted-foreground md:flex-row"
	>
		<p class="font-sans">&copy; {new Date().getFullYear()} Spikonado</p>
		<div class="flex items-center gap-6">
			{
				ORGANIZATION_SOCIALS.map(({ label, href }) => (
					<a
						href={href}
						target="_blank"
						rel="noopener noreferrer"
						class="transition-transform duration-150 hover:scale-105"
					>
						<img loading="lazy" src={socialIcons[label].src} alt={label} class="h-7 w-7" />
					</a>
				))
			}
		</div>
	</div>
</footer>
