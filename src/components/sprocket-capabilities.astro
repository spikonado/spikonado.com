---
import ProductImagePlaceholder from '@/components/product-image-placeholder.astro';
import { marketingSectionBodyClass, marketingSectionHeadingClass } from '@/styles/marketing';
import { cn } from '@/utils';

const capabilities = [
	{
		id: 'web-context',
		category: 'Rich web context',
		heading: 'Read the page.',
		accent: 'Not just the snippet.',
		body: "Work from current API docs, technical guides, and supplier pages. Sprocket prefers a site's Markdown, uses Firecrawl to read dynamic pages, and saves long results instead of cutting them short.",
		image: 'API documentation + supplier page → web context',
		caption: 'The source content stays available for the agent to read.',
		note: ''
	},
	{
		id: 'file-context',
		category: 'Built-in document parsing',
		heading: 'Your files.',
		accent: 'Usable context.',
		body: 'Turn PDFs, Word documents, slides, and spreadsheets into Markdown the agent can work from. Bring in a product brief, a test report, or a datasheet without converting it yourself.',
		image: 'Product brief + spreadsheet + datasheet → Markdown',
		caption: 'One parsing tool, across document formats and model choices.',
		note: 'Supported formats and size limits apply. Documents that need hosted parsing or OCR are sent to Firecrawl.'
	},
	{
		id: 'purchasing',
		category: 'Agentic purchasing',
		heading: 'Approve it.',
		accent: 'Let Sprocket buy it.',
		body: 'Ask Sprocket to buy a SaaS subscription or electronics. Approve a merchant and spending limit, then let the agent complete checkout using a single-use payment credential.',
		image: 'SaaS subscription + electronics → spending approval + checkout',
		caption: 'Buy the services and components your project needs.',
		note: 'Standing mandates can allow later charges without another approval. Merchant and payment-service support varies.'
	},
	{
		id: 'project-artifacts',
		category: 'Live project artifacts',
		heading: 'Live files.',
		accent: 'Shared context.',
		body: 'Publish interactive HTML or React previews and Markdown reports from real project files. Keep edits synced and open the same artifacts from any thread in the project.',
		image: 'Interactive app mockup + design report → shared project artifacts',
		caption: 'A live preview backed by a file you can keep working on.',
		note: ''
	}
] as const;
---

{
	capabilities.map((capability, index) => (
		<section
			id={capability.id}
			class={cn('border-t border-border/50', index % 2 === 0 ? 'bg-background' : 'bg-surface')}
			aria-labelledby={`${capability.id}-heading`}
			data-ph-section={`sprocket_${capability.id}`}
		>
			<div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-28">
				<div class={index % 2 === 1 ? 'lg:order-2' : ''}>
					<p class="font-mono text-xs font-medium tracking-[0.14em] text-accent-strong uppercase">
						{capability.category}
					</p>
					<h2 id={`${capability.id}-heading`} class={cn(marketingSectionHeadingClass, 'mt-3')}>
						{capability.heading} <span class="mark-accent">{capability.accent}</span>
					</h2>
					<p class={cn(marketingSectionBodyClass, 'mt-6')}>{capability.body}</p>
					{capability.note && (
						<p class="mt-4 max-w-md text-sm leading-relaxed text-muted-foreground">
							{capability.note}
						</p>
					)}
				</div>
				<figure class={cn('min-w-0', index % 2 === 1 && 'lg:order-1')}>
					<div class="overflow-hidden rounded-2xl border border-border/70 bg-ink shadow-[0_30px_80px_-40px_oklch(0.2_0.02_260/0.7)]">
						<ProductImagePlaceholder label={capability.image} />
					</div>
					<figcaption class="mt-4 text-sm leading-relaxed text-muted-foreground">
						{capability.caption}
					</figcaption>
				</figure>
			</div>
		</section>
	))
}
