---
import ProductImagePlaceholder from '@/components/product-image-placeholder.astro';
import { marketingSectionBodyClass, marketingSectionHeadingClass } from '@/styles/marketing';
import { cn } from '@/utils';

const capabilities = [
	{
		id: 'building',
		category: 'Software and hardware',
		heading: 'Write the code.',
		accent: 'Design the circuit.',
		body: 'Build an app, develop firmware, or design electronics. Sprocket writes and tests code, creates schematics, and prepares parts lists and assembly guides. Work on software, hardware, or the two together.',
		image: 'App code + firmware + circuit schematic',
		caption: 'Project files you can inspect, edit, and build on.',
		note: 'Review the results before using them. Hardware designs need validation before you build.'
	},
	{
		id: 'web-context',
		category: 'Context from the web',
		heading: 'Build from',
		accent: 'the source.',
		body: 'Sprocket reads current documentation, datasheets, and supplier pages to inform its work. It extracts full page content, including dynamic websites, and keeps long results available instead of cutting them short.',
		image: 'API documentation + datasheet + changes to the project',
		caption: 'Current technical information put to use in your build.',
		note: ''
	},
	{
		id: 'project-inputs',
		category: 'Context from your files',
		heading: 'Your documents.',
		accent: 'Part of the build.',
		body: 'Bring a product brief, a PDF datasheet, slides, or a spreadsheet. Sprocket converts documents into structured text it can work with, reads images, and uses the details in your project. No manual conversion needed.',
		image: 'Product brief + PDF + spreadsheet → project changes',
		caption: 'Requirements and specifications alongside the code and design.',
		note: 'File formats and size limits apply. Documents that need online conversion or text extraction are sent to Firecrawl.'
	},
	{
		id: 'purchasing',
		category: 'Purchasing built in',
		heading: 'Source it.',
		accent: 'Buy it.',
		body: 'Ask Sprocket to find and purchase electronics or a SaaS subscription. Approve the merchant and spending limit, then let it complete checkout with a single-use payment credential.',
		image: 'Electronics + SaaS subscription + spending approval + checkout',
		caption: 'From choosing what you need to paying for it.',
		note: 'Standing approvals can allow later purchases within their limits. Merchant and payment-service support varies.'
	}
] as const;
---

{
	capabilities.map((capability, index) => (
		<section
			id={capability.id}
			class={cn('border-t border-border/50', index % 2 === 0 ? 'bg-background' : 'bg-surface')}
			aria-labelledby={`${capability.id}-heading`}
			data-ph-section={`sprocket_${capability.id}`}
		>
			<div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-28">
				<div class={index % 2 === 1 ? 'lg:order-2' : ''}>
					<p class="font-mono text-xs font-medium tracking-[0.14em] text-accent-strong uppercase">
						{capability.category}
					</p>
					<h2 id={`${capability.id}-heading`} class={cn(marketingSectionHeadingClass, 'mt-3')}>
						{capability.heading} <span class="mark-accent">{capability.accent}</span>
					</h2>
					<p class={cn(marketingSectionBodyClass, 'mt-6')}>{capability.body}</p>
					{capability.note && (
						<p class="mt-4 max-w-md text-sm leading-relaxed text-muted-foreground">
							{capability.note}
						</p>
					)}
				</div>
				<figure class={cn('min-w-0', index % 2 === 1 && 'lg:order-1')}>
					<div class="overflow-hidden rounded-2xl border border-border/70 bg-ink shadow-[0_30px_80px_-40px_oklch(0.2_0.02_260/0.7)]">
						<ProductImagePlaceholder label={capability.image} />
					</div>
					<figcaption class="mt-4 text-sm leading-relaxed text-muted-foreground">
						{capability.caption}
					</figcaption>
				</figure>
			</div>
		</section>
	))
}
