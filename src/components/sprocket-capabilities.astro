---
import ProductImagePlaceholder from '@/components/product-image-placeholder.astro';
import { marketingSectionBodyClass, marketingSectionHeadingClass } from '@/styles/marketing';
import { cn } from '@/utils';

const capabilities = [
	{
		id: 'building',
		category: 'From idea to project',
		heading: 'Describe it.',
		accent: 'Start building.',
		body: 'Ask for an app, a website, or a new feature. Sprocket writes the code, changes your project files, and runs checks. Building a device? It can also create electronics diagrams, parts lists, and assembly guides.',
		image: 'An idea in the chat + the app Sprocket is building',
		caption: 'Start a new project or work on one you already have.',
		note: 'Review the results before using them. Hardware designs need validation before you build.'
	},
	{
		id: 'iteration',
		category: 'Make it yours',
		heading: 'See it.',
		accent: 'Shape it.',
		body: 'Review previews and project files as Sprocket works. Ask for a simpler layout, another feature, or a fix. It makes the changes, and you keep the files.',
		image: 'App preview + a request for changes + the updated app',
		caption: 'Keep improving the result through conversation.',
		note: ''
	},
	{
		id: 'project-inputs',
		category: 'Use what you have',
		heading: 'Bring your',
		accent: 'starting point.',
		body: 'Share a brief, a screenshot, a spreadsheet, or a technical document. Sprocket reads your materials and looks up current information online to help build what you asked for.',
		image: 'A brief + a reference image + the project taking shape',
		caption: 'Your materials help Sprocket understand what to make.',
		note: 'File formats and size limits apply. Documents that need online conversion or text extraction are sent to Firecrawl.'
	},
	{
		id: 'purchasing',
		category: 'Parts and subscriptions',
		heading: 'Get what',
		accent: 'you need.',
		body: 'Need an online service for your app or electronics for a prototype? Ask Sprocket to find and buy them. You approve the seller and spending limit before it can pay.',
		image: 'An online subscription + electronics + spending approval',
		caption: 'Purchasing can be part of the same project conversation.',
		note: 'A standing approval can allow later purchases within its limits. Store and payment support varies.'
	}
] as const;
---

{
	capabilities.map((capability, index) => (
		<section
			id={capability.id}
			class={cn('border-t border-border/50', index % 2 === 0 ? 'bg-background' : 'bg-surface')}
			aria-labelledby={`${capability.id}-heading`}
			data-ph-section={`sprocket_${capability.id}`}
		>
			<div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-28">
				<div class={index % 2 === 1 ? 'lg:order-2' : ''}>
					<p class="font-mono text-xs font-medium tracking-[0.14em] text-accent-strong uppercase">
						{capability.category}
					</p>
					<h2 id={`${capability.id}-heading`} class={cn(marketingSectionHeadingClass, 'mt-3')}>
						{capability.heading} <span class="mark-accent">{capability.accent}</span>
					</h2>
					<p class={cn(marketingSectionBodyClass, 'mt-6')}>{capability.body}</p>
					{capability.note && (
						<p class="mt-4 max-w-md text-sm leading-relaxed text-muted-foreground">
							{capability.note}
						</p>
					)}
				</div>
				<figure class={cn('min-w-0', index % 2 === 1 && 'lg:order-1')}>
					<div class="overflow-hidden rounded-2xl border border-border/70 bg-ink shadow-[0_30px_80px_-40px_oklch(0.2_0.02_260/0.7)]">
						<ProductImagePlaceholder label={capability.image} />
					</div>
					<figcaption class="mt-4 text-sm leading-relaxed text-muted-foreground">
						{capability.caption}
					</figcaption>
				</figure>
			</div>
		</section>
	))
}
