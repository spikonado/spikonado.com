---
import logo from '@/assets/logo.svg';

interface Props {
	label: string;
	thread: string;
	model?: string;
}

const { label, thread, model = 'Opus 5.5 · High' } = Astro.props;

const iconProps = {
	viewBox: '0 0 24 24',
	fill: 'none',
	stroke: 'currentColor',
	'stroke-width': '2',
	'stroke-linecap': 'round',
	'stroke-linejoin': 'round'
} as const;
---

<div
	data-mock
	role="img"
	aria-label={label}
	class="overflow-hidden rounded-2xl border border-border/80 bg-surface font-sans text-[0.8125rem] leading-relaxed text-foreground shadow-[0_30px_80px_-40px_oklch(0.2_0.02_260/0.6)]"
>
	<div
		class="flex items-center gap-2 border-b border-border/70 bg-accent-soft/40 px-4 py-2.5"
		aria-hidden="true"
	>
		<img src={logo.src} alt="" width="16" height="16" class="h-4 w-4" />
		<span class="font-semibold">Sprocket</span>
		<span class="text-muted-foreground">/</span>
		<span class="truncate text-muted-foreground">{thread}</span>
	</div>
	<div class="flex min-h-80 flex-col gap-2.5 px-4 py-4 sm:px-5" aria-hidden="true">
		<slot />
	</div>
	<div class="px-3 pb-3" aria-hidden="true">
		<div
			class="rounded-[1.25rem] border border-border/80 bg-surface px-3.5 pt-3 pb-2.5 shadow-[0_6px_20px_-12px_oklch(0.2_0.02_260/0.35)]"
		>
			<p class="truncate pb-5 text-muted-foreground">
				Ask anything, use / for commands, @ to tag files/folders, and $ for skills
			</p>
			<div class="flex items-center gap-3 text-xs text-foreground/80">
				<svg {...iconProps} class="h-3.5 w-3.5 text-muted-foreground">
					<path
						d="m21.4 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"
					></path>
				</svg>
				<span class="h-4 w-px bg-border"></span>
				<span class="inline-flex items-center gap-1">
					<svg viewBox="0 0 24 24" class="mr-0.5 h-3 w-3" fill="#D97757">
						<path
							d="m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z"
						></path>
					</svg>
					{model}
					<svg {...iconProps} class="h-3 w-3 text-muted-foreground">
						<path d="m6 9 6 6 6-6"></path>
					</svg>
				</span>
				<span
					class="ml-auto flex h-7 w-7 items-center justify-center rounded-full bg-muted-foreground/40 text-surface"
				>
					<svg {...iconProps} class="h-3.5 w-3.5">
						<path d="M12 19V5M5 12l7-7 7 7"></path>
					</svg>
				</span>
			</div>
		</div>
	</div>
</div>

<style is:global>
	@keyframes mock-step-in {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes mock-step-out {
		to {
			opacity: 0;
		}
	}

	[data-mock][data-animate] [data-step] {
		opacity: 0;
	}

	[data-mock][data-animate].is-playing [data-step] {
		animation: mock-step-in 0.45s ease-out forwards;
		animation-delay: calc(var(--step, 0) * 0.65s);
	}

	[data-mock]:not([data-animate]) [data-step-out] {
		opacity: 0;
	}

	[data-mock][data-animate].is-playing [data-step-out] {
		animation: mock-step-out 0.2s ease-in forwards;
		animation-delay: calc(var(--step-out, 0) * 0.65s);
	}
</style>

<script>
	// Steps stay visible without JS or with reduced motion; they're only hidden once we can reveal them.
	const mocks = document.querySelectorAll<HTMLElement>('[data-mock]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!reduceMotion && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-playing');
						observer.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.35 }
		);
		for (const mock of mocks) {
			mock.dataset.animate = '';
			observer.observe(mock);
		}
	}
</script>
