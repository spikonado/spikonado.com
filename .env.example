PUBLIC_POSTHOG_KEY=example-posthog-key
RESEND_API_KEY=re_example

# Billing (Sprocket subscriptions via the Sprocket Convex deployment + Dodo).
#
# Convex deployment URL for the Sprocket backend (https://<deployment>.convex.cloud).
# Billing UI stays disabled with an actionable error while this is unset.
#PUBLIC_CONVEX_URL=
#
# Expected Dodo checkout mode. Must agree with the backend's
# DODO_PAYMENTS_ENVIRONMENT (test_mode <-> "test", live_mode <-> "live").
# Unset/invalid values disable checkout with an explicit error; checkout
# only defaults to "test" on localhost. Production must set "live" explicitly.
#PUBLIC_DODO_CHECKOUT_MODE=
#
# Server-only WorkOS secrets. API key must match the environment selected by
# the Convex deployment's WORKOS_CLIENT_ID. No custom WorkOS domain is needed.
#WORKOS_API_KEY=
# Random secret of at least 32 characters, stable across deployments/instances.
#WORKOS_COOKIE_PASSWORD=
